    "facts": {
      "name": "mark marshall"
    }
  },
  "max_seconds": 360,
  "hangup_after": "date of birth|been to see us before|been to the clinic|different name",
  "steps": [
    {
      "when": "how can i help",
      "clips": [
        "2026-11-24T101247Z_nv9n_01_opener"
      ],
      "intended": "Sophie, I'm having knee pain. Can you help me?",
      "max_uses": 2
    },
    {
      "when": "full name|your name|registered under",
