# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voicenoob

# Redis
REDIS_URL=redis://localhost:6379/0

# Security (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Default Admin (created on first startup if no users exist)
# IMPORTANT: Change these values before running!
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_BEFORE_RUNNING
ADMIN_NAME=Admin

# QA Testing Framework (optional - for post-call evaluation)
# Required for QA evaluations to work
ANTHROPIC_API_KEY=sk-ant-your-key-here

# QA Feature Flags
QA_ENABLED=false
QA_AUTO_EVALUATE=true
QA_DEFAULT_THRESHOLD=70
QA_EVALUATION_MODEL=claude-sonnet-4-20250514
QA_MAX_CONCURRENT_EVALUATIONS=5
QA_ALERT_ON_FAILURE=true
QA_ENABLE_LATENCY_TRACKING=true
QA_ENABLE_TURN_ANALYSIS=true
QA_ENABLE_QUALITY_METRICS=true

# --- Telephony: everything below is required for a real phone call ---

# The public origin of this backend. The answer document builds the media
# stream URL from it and the carrier dials that URL. Unset, it falls back to
# the request's own host, which behind a TLS-terminating proxy is the internal
# address the app is bound to: the call connects, the row lands, and the caller
# hears silence. See docs/HANDOFF.md section 7.2.
PUBLIC_URL=https://api.synthiqvoice.com

# Telnyx webhook signature verification. Required in production.
# With this unset, verification falls back to DEBUG: DEBUG=false rejects every
# webhook 403, DEBUG=true accepts every webhook unverified.
TELNYX_PUBLIC_KEY=

# Only for outbound calls and the number-purchase flow. Inbound does not use it.
TELNYX_API_KEY=

# Must be false in production. See TELNYX_PUBLIC_KEY above.
DEBUG=false

# The OpenAI key is NOT set here. The call path reads it from the agent's
# workspace (Settings > Workspace API Keys in the dashboard), with no fallback
# to the environment.

# Tracing (optional; the call works without it). A trace carries transcripts,
# so a cleartext endpoint to a non-loopback host is refused.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
