# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voicenoob

# Redis
# Required for phone calls, not only for caching. Each call's stream token is
# claimed in Redis so it can be used once; while Redis is unreachable every
# carrier media stream is refused (log: stream_token_claim_store_unavailable).
# Every backend instance must point at the same Redis.
REDIS_URL=redis://localhost:6379/0

# Security (generate with: python -c "import secrets; print(secrets.token_hex(32))")
# REQUIRED. There is no usable default: the app refuses to start on this
# placeholder, or on an empty value, unless DEBUG=true.
# Generate one with: openssl rand -hex 32
# It signs login tokens, the tokens that admit a carrier's media stream, and
# embedded widget sessions. Every backend instance must share the same value.
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Encrypts the provider keys and integration credentials customers store.
# Format: <id>:<base64 32-byte key>, comma separated. The first entry encrypts;
# every entry can decrypt, which is how a key is rotated (see DEPLOYMENT.md).
# The app refuses to start without it unless DEBUG=true. Keep a copy off the
# server: losing it loses every stored credential.
# Generate: python -c "import secrets,base64;print('k1:'+base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
CREDENTIAL_ENCRYPTION_KEYS=

# Daily deletion of call data past each account's retention period.
RETENTION_SWEEP_ENABLED=true
RETENTION_SWEEP_INTERVAL_HOURS=24

# Default Admin (created on first startup if no users exist)
# IMPORTANT: Change these values before running!
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_BEFORE_RUNNING
ADMIN_NAME=Admin

# QA Testing Framework (optional - for post-call evaluation)
# Required for QA evaluations to work
ANTHROPIC_API_KEY=sk-ant-your-key-here

# QA Feature Flags
QA_ENABLED=false
QA_AUTO_EVALUATE=true
QA_DEFAULT_THRESHOLD=70
QA_EVALUATION_MODEL=claude-sonnet-4-20250514
QA_MAX_CONCURRENT_EVALUATIONS=5
QA_ALERT_ON_FAILURE=true
QA_ENABLE_LATENCY_TRACKING=true
QA_ENABLE_TURN_ANALYSIS=true
QA_ENABLE_QUALITY_METRICS=true

# --- Telephony: everything below is required for a real phone call ---

# The public origin of this backend. The answer document builds the media
# stream URL from it and the carrier dials that URL. Unset, it falls back to
# the request's own host, which behind a TLS-terminating proxy is the internal
# address the app is bound to: the call connects, the row lands, and the caller
# hears silence. See docs/HANDOFF.md section 7.2.
PUBLIC_URL=https://api.synthiqvoice.com

# Telnyx webhook signature verification. Required for any instance that takes
# a call. With this unset every webhook is refused 403, whatever DEBUG says.
TELNYX_PUBLIC_KEY=

# Accept carrier webhooks WITHOUT a verified signature. Leave this false. It
# exists only for a local rehearsal with no carrier key; with it on, anyone who
# can reach this host can post a call to it, and the app logs that at startup.
ALLOW_UNSIGNED_WEBHOOKS=false

# Only for outbound calls and the number-purchase flow. Inbound does not use it.
TELNYX_API_KEY=

# Twilio webhook signature verification. A Twilio webhook is checked first
# against the auth token of the workspace that owns the number, agent or call
# it is about (Settings > Workspace API Keys in the dashboard), then against
# this one. Set these only when every number runs on one platform-wide Twilio
# account. With neither a workspace token nor this one, Twilio webhooks are
# refused 403.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Embeddable widget ---

# Origin of the web app, which serves the widget script and the embed page.
# Optional: the embed snippet falls back to the first CORS origin, then to
# PUBLIC_URL.
FRONTEND_URL=http://localhost:3000

# An agent with no allowed domains can be embedded by no other site. Setting
# this to true restores the old meaning ("every site") and logs a warning each
# time it is why a request was served. Leave it false and fill in each agent's
# allowed domains.
EMBED_ALLOW_ANY_ORIGIN_WHEN_UNSET=false

# The longest an embedded session can run, in seconds, and the lifetime of its
# signed session token. The session is closed when it is reached.
EMBED_SESSION_MAX_SECONDS=900

# Whether embedded sessions may call an agent's tools when the agent's own
# embed settings do not say (embed_settings.allow_tools). Leave it false: a
# tool call from the widget acts with the owner's integrations on an anonymous
# visitor's input.
EMBED_TOOLS_DEFAULT_ENABLED=false

# Must be false in production. It no longer affects webhook verification; it
# does skip the startup check that refuses a placeholder SECRET_KEY.
DEBUG=false

# The OpenAI key is NOT set here. The call path reads it from the agent's
# workspace (Settings > Workspace API Keys in the dashboard), with no fallback
# to the environment.

# Tracing (optional; the call works without it). A trace carries transcripts,
# so a cleartext endpoint to a non-loopback host is refused.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
