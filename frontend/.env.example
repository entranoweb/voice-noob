# Both are baked in at build time; changing them needs a rebuild.
# The embeddable widget page is served by this app and opens its signed
# session against NEXT_PUBLIC_API_URL, so deploy the frontend together with
# the backend: an older widget page cannot start a session on a newer backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
