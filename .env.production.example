# =============================================================================
# SYNTHIQ VOICE PLATFORM - Production Environment Variables
# =============================================================================
# Copy this to .env.production and fill in your values
# For Coolify: Add these as environment variables in the Coolify dashboard
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=voice_agent

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
REDIS_PASSWORD=your_secure_redis_password_here

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED. There is no default: the compose file fails without it and the app
# refuses to start on this placeholder. It signs login tokens, the tokens that
# admit a carrier's media stream to an agent, and embedded widget sessions.
# Every backend instance must share the same value.
SECRET_KEY=your_64_character_secret_key_here

# Encrypts the provider keys and integration credentials customers store.
# Format: <id>:<base64 32-byte key>, comma separated. The first entry encrypts;
# every entry can decrypt, which is how a key is rotated (see DEPLOYMENT.md).
# The app refuses to start without it unless DEBUG=true. Keep a copy off the
# server: losing it loses every stored credential.
# Generate: python -c "import secrets,base64;print('k1:'+base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
CREDENTIAL_ENCRYPTION_KEYS=

# -----------------------------------------------------------------------------
# ADMIN USER (Created on first startup)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_NAME=Admin

# -----------------------------------------------------------------------------
# URLs (Set these to your actual domain)
# -----------------------------------------------------------------------------
# Your public domain where the platform is hosted
FRONTEND_URL=https://voice.yourcompany.com
BACKEND_URL=https://api.voice.yourcompany.com
BACKEND_WS_URL=wss://api.voice.yourcompany.com

# -----------------------------------------------------------------------------
# TELEPHONY (PUBLIC_URL is REQUIRED: docker-compose.prod.yml refuses to start without it)
# -----------------------------------------------------------------------------
# The public origin of the BACKEND. The carrier dials the media stream URL
# built from it, and Twilio signatures are checked against it.
PUBLIC_URL=https://api.voice.yourcompany.com

# Telnyx webhook signature verification. A webhook is checked first against
# the public key of the workspace that owns the number or call (entered in
# the dashboard), then against this one. Set it only when every number runs
# on one platform-wide Telnyx account; otherwise leave it empty. With
# neither key, the webhook is refused 403.
TELNYX_PUBLIC_KEY=

# Outbound calls and buying numbers only.
# TELNYX_API_KEY=

# Must stay false. It skips the startup check on SECRET_KEY.
DEBUG=false

# The next three are read once the tenant-isolation change (#33) is merged;
# before that they are ignored.
#
# Whether anyone may create an account. Leave false: accounts are created by
# the administrator.
ALLOW_PUBLIC_SIGNUP=false

# Serve /docs and /openapi.json. Leave false on a public host.
ENABLE_API_DOCS=false

# When set, /metrics answers only to `Authorization: Bearer <this>`.
# Generate with: openssl rand -hex 32
METRICS_TOKEN=

# Where rate-limit counts are kept. Leave empty: the Redis above, shared by
# every worker. "memory://" counts per process.
RATE_LIMIT_STORAGE_URI=

# Twilio needs nothing here: each workspace's own Twilio auth token is entered
# in the dashboard (Settings > Workspace API Keys) and webhooks are verified
# against it.

# Redis is part of the call path: each call's stream token is claimed there so
# it can be used once, and calls are refused while Redis is unreachable.

# -----------------------------------------------------------------------------
# OPTIONAL, PASSED BY docker-compose.prod.yml
# -----------------------------------------------------------------------------
# The compose file passes the backend only the variables it lists. These are in
# that list; their defaults are the safe values.
#   ALLOW_UNSIGNED_WEBHOOKS=false          never true on a real number
#   EMBED_ALLOW_ANY_ORIGIN_WHEN_UNSET=false
#   EMBED_SESSION_MAX_SECONDS=900
#   EMBED_TOOLS_DEFAULT_ENABLED=false
#   TWILIO_ACCOUNT_SID= / TWILIO_AUTH_TOKEN=   one platform-wide Twilio account
#   CALL_TOOL_GRACE_S=10                   seconds a running tool may finish after the call ends
#   SHUTDOWN_DRAIN_TIMEOUT=15              seconds the worker waits on shutdown for call entries to clear
#     The app refuses to start unless CALL_TOOL_GRACE_S + 5 + SHUTDOWN_DRAIN_TIMEOUT <= 40
#     (gunicorn's graceful timeout). With the default drain the largest grace is 20.
#   OPENAI_REALTIME_MODEL_PREMIUM=gpt-realtime-2.1
#   OPENAI_REALTIME_MODEL_PREMIUM_MINI=gpt-realtime-2.1-mini
#   OPENAI_REALTIME_INPUT_TRANSCRIPTION_MODEL=gpt-transcribe   empty: no caller transcript

# -----------------------------------------------------------------------------
# TELNYX WEBHOOKS (Set in Telnyx Portal)
# -----------------------------------------------------------------------------
# Voice Webhook URL: https://api.voice.yourcompany.com/webhooks/telnyx/voice
# Status Webhook URL: https://api.voice.yourcompany.com/webhooks/telnyx/status
# Answer Webhook URL: https://api.voice.yourcompany.com/webhooks/telnyx/answer

# -----------------------------------------------------------------------------
# OPTIONAL: Monitoring
# -----------------------------------------------------------------------------
# SENTRY_DSN=https://xxx@sentry.io/xxx
# SENTRY_ENVIRONMENT=production
